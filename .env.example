# Backend
HOST=127.0.0.1
PORT=4000
REGISTRY_DIR=config/registry
# Optional append-only journal of accepted submissions (JSON lines)
# SUBMISSION_JOURNAL=/var/lib/lp/submissions.jsonl
# Destination secrets are read by name from the registry's "authEnv" field, e.g.:
# CRM_TOKEN=...
# BREERO_TOKEN=...
# Optional local-only Front Desk demo link. Start the separate app first.
# FRONT_DESK_DEMO_ORIGIN=http://127.0.0.1:4317

# Pages (each page process)
# PORT=4173
# BACKEND_URL=http://127.0.0.1:4000
