{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@lp/core": ["./packages/core/src/index.ts"],
      "@lp/core/*": ["./packages/core/src/*"],
      "@lp/ui": ["./packages/ui/src/index.ts"],
      "@lp/ui/*": ["./packages/ui/src/*"],
      "@lp/page-kit": ["./packages/page-kit/src/serve.mjs"],
      "@lp/page-kit/vite": ["./packages/page-kit/src/vite.mjs"]
    }
  }
}
