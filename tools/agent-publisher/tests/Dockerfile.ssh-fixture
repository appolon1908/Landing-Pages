FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 1000 --create-home --shell /bin/sh git \
 && usermod --password '*' git \
 && mkdir -p /run/sshd /home/git/appolon1908
RUN printf '%s\n' \
  'Port 22' \
  'HostKey /run/fixture-host-key' \
  'AuthorizedKeysFile /run/fixture-authorized-keys' \
  'PasswordAuthentication no' \
  'KbdInteractiveAuthentication no' \
  'PermitRootLogin no' \
  'UsePAM no' \
  'AllowUsers git' > /etc/ssh/sshd_config
CMD ["/usr/sbin/sshd", "-D", "-e"]
