{
  "name": "landing-pages",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "pages/*"
  ],
  "scripts": {
    "backend": "node backend/src/index.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:page": "npm run build --workspace=pages/$PAGE",
    "start:page": "npm start --workspace=pages/$PAGE",
    "new-page": "node scripts/new-page.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/unit/*.test.ts tests/backend/*.test.mjs tests/pagekit/*.test.mjs tests/content/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write packages backend pages scripts tests deploy \"config/**/*.json\" marketing *.json",
    "format:check": "prettier --check packages backend pages scripts tests deploy \"config/**/*.json\" marketing *.json",
    "compliance:check": "node scripts/check_compliance.ts",
    "registry:check": "node scripts/check_registry.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run registry:check && npm run content:check && npm run assets:check && npm run marketing:validate && npm test && npm run test:deploy && npm run build && npm run budget:check && npm run assets:check-built && npm run test:browser",
    "test:content": "node --test tests/content/*.test.mjs",
    "content:check": "node scripts/check_content.mjs",
    "marketing:validate": "node marketing/_tooling/validate.mjs",
    "marketing:export": "node marketing/_tooling/export-meta.mjs",
    "budget:check": "node scripts/check_budget.mjs",
    "test:deploy": "node scripts/test_deploy.mjs",
    "assets:check": "node scripts/check_assets.mjs",
    "assets:check-built": "node scripts/check_assets.mjs --built"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vue-tsc": "3.3.13"
  }
}
