{
  "name": "codestra-landing-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node --experimental-strip-types server/index.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check apps packages server tests *.json *.ts",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vue-tsc": "3.3.13"
  }
}
